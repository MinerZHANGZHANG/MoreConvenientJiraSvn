<UserControl
    x:Class="MoreConvenientJiraSvn.App.Views.Controls.VersionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MoreConvenientJiraSvn.App.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:MoreConvenientJiraSvn.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:VersionControlViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,32,0,16"
            HorizontalAlignment="Center">
            <!--  Logo  -->
            <Image
                Width="96"
                Height="96"
                Source="/Resources/Images/Logo.png"
                Stretch="Uniform" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            HorizontalAlignment="Center">
            <!--  Current Version and GitHub Link  -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="当前版本: " />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource AccentBrush}"
                Text="{Binding CurrentVersionText}" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center">
                <Hyperlink RequestNavigate="Hyperlink_RequestNavigate">
                    <TextBlock Text="{Binding AppRepoUrl}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        <DockPanel
            Grid.Row="2"
            Margin="32,0,32,16"
            VerticalAlignment="Center"
            LastChildFill="False">
            <!--  Latest Version and Update Button  -->
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="最新版本: " />
            <TextBlock
                Margin="4,0,16,0"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="Bold"
                Foreground="{DynamicResource AccentBrush}"
                Text="{Binding LatestVersionText}" />
            <Button
                Padding="16,4"
                Command="{Binding RefreshLatestVersionCommand}"
                Content="刷新"
                DockPanel.Dock="Right" />
        </DockPanel>
        <Border
            Grid.Row="3"
            Margin="32,0,32,32"
            Padding="16"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="8">
            <!--  Update Info Scrollable TextBox  -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <FlowDocumentScrollViewer
                    Grid.Row="1"
                    Margin="5"
                    Document="{Binding UpdateLogDocument}"
                    VerticalScrollBarVisibility="Auto" />
            </ScrollViewer>
        </Border>
        <Grid
            Grid.Row="4"
            Margin="16,0,16,16"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Latest Version and Update Button  -->
            <ProgressBar
                Grid.Column="0"
                Height="16"
                Margin="4"
                Maximum="1"
                Style="{StaticResource MaterialDesignLinearProgressBar}"
                Value="{Binding DownloadProgressValue}" />
            <Button
                Grid.Column="1"
                Margin="16,4"
                Command="{Binding UpdateVersionCommand}"
                Content="下载并更新"
                DockPanel.Dock="Right" />
        </Grid>
    </Grid>
</UserControl>
